# Absolute path to the local SQLite database file (Prisma).
# The db: scripts in package.json inline this value via $(pwd), but if you
# run prisma manually, export this var first.
DATABASE_URL=file:/home/z/my-project/apps/36-voice-to-task/db/custom.db

# --- Optional: LLM / ASR behavior ---
# Set to "1" to force the MockChatProvider (offline deterministic task parsing).
VTT_DISABLE_LLM=0
# Set to "1" to force the MockAsrProvider (offline deterministic transcription).
VTT_DISABLE_ASR=0

# --- Optional: multi-system sync (stretch goal) ---
# Todoist API token — when set, completed tasks also push to Todoist.
TODOIST_API_TOKEN=
# Linear API key + team slug — when set, tasks tagged /work push to Linear.
LINEAR_API_KEY=
LINEAR_TEAM=
# Notion integration token + database id — when set, tasks push to a Notion DB.
NOTION_TOKEN=
NOTION_DATABASE_ID=
